---
import '../styles/global.css';
const {title,description,path:route='/',wide=false}=Astro.props;
const canonical=new URL(route,Astro.site).href;
const nav=[['Work','/work/'],['Product','/lomvren/'],['Roadmap','/Ai-GenAi-Engineer/'],['About','/about/']];
const person={'@type':'Person','@id':Astro.site+'#ganesh',name:'Paladugu Ganesh Naidu',url:Astro.site,image:new URL('/images/profile/ganesh-naidu.jpg',Astro.site).href,jobTitle:'AI Systems Engineer & Full-Stack Engineer',sameAs:['https://github.com/paladuguganeshnaidu','https://www.linkedin.com/in/paladuguganeshnaidu']};
---
<!doctype html><html lang="en-IN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content="index,follow,max-image-preview:large"/><meta name="theme-color" content="#f5f4ef"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/profile/ganesh-naidu.jpg',Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL('/images/profile/ganesh-naidu.jpg',Astro.site).href}/><link rel="icon" href="/favicon.svg"/><link rel="manifest" href="/site.webmanifest"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[person,{'@type':'WebSite',name:'Paladugu Ganesh Naidu',url:Astro.site},{'@type':'WebPage',name:title,description,url:canonical,about:{'@id':Astro.site+'#ganesh'}}]})}/></head><body class:list={[{wide}]}><a class="skip" href="#main">Skip to content</a><div class="ambient" aria-hidden="true"></div><header><div class="wrap nav"><a href="/" class="brand" aria-label="Ganesh Naidu home">gn<span>✳</span></a><nav id="navigation" aria-label="Main navigation">{nav.map(([label,href])=><a href={href} aria-current={route===href?'page':undefined}>{label}</a>)}</nav><a class="nav-contact" href="mailto:paladuguganeshnaidu@gmail.com">Let’s talk <span>↗</span></a><button class="menu" aria-label="Open navigation" aria-expanded="false" aria-controls="navigation">Menu</button></div></header><main id="main"><slot/></main><footer class="wrap"><div class="footer-top"><p>Have something<br/><strong>worth building?</strong></p><a class="button dark" href="mailto:paladuguganeshnaidu@gmail.com">Start a conversation ↗</a></div><div class="footer-links"><a href="/lab/">Lab</a><a href="/journey/">Journey</a><a href="/research/">Research</a><a href="/certifications/">Certifications</a><a href="/myworld/">My world</a><a href="/resume/">Resume</a><a href="https://github.com/paladuguganeshnaidu">GitHub ↗</a><a href="https://www.linkedin.com/in/paladuguganeshnaidu">LinkedIn ↗</a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Paladugu Ganesh Naidu</span><span>Made with curiosity. Built in public.</span><button id="motion-toggle" aria-pressed="false">Pause motion</button></div></footer><script>import '../scripts/site.js';</script></body></html>