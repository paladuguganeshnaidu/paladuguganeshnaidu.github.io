---
import Layout from '../layouts/Layout.astro';
import milestones from '../data/milestones.json';
import pages from '../data/pages.json';
import roadmap from '../data/roadmap.json';
---
<Layout title="3D Space & My Journey | Ganesh Naidu" description="Explore Ganesh Naidu’s engineering journey in an interactive 3D constellation: education, work, communities, AI projects, research and the complete learning roadmap." path="/space/"><section class="wrap page-hero"><div class="eyebrow">MY JOURNEY / A CONNECTED UNIVERSE</div><h1>Every step.<br/><em>A new constellation.</em></h1><p class="lead">Explore the milestones that connect my learning, work, products and research. Select a planet or choose a milestone below.</p></section><section class="wrap space-explorer"><div class="space-canvas" id="journey-space" aria-label="Interactive 3D journey constellation"><p class="space-fallback">Every milestone is available below. The constellation is an optional way to explore.</p><span class="space-hint">Drag to orbit · scroll to zoom · select a planet</span></div><div class="space-selection" aria-live="polite"><span id="space-year" class="eyebrow">{milestones[0].year}</span><h2 id="space-title">{milestones[0].title}</h2><p id="space-text">{milestones[0].text}</p><a id="space-link" class="text-link" href={milestones[0].href}>Explore this chapter ↗</a></div></section><section class="wrap section journey-timeline"><div class="eyebrow">THE COMPLETE JOURNEY / EXPERIENCE & MILESTONES</div><div class="milestone-grid">{milestones.map((m,i)=><button class:list={['milestone',{selected:i===0}]} data-milestone={i} aria-pressed={i===0?'true':'false'}><span>{m.year}</span><h3>{m.title}</h3><p>{m.text}</p><b>Explore this milestone ↗</b></button>)}</div></section><div class="legacy" set:html={pages.journey.html.replace('<h1>','<h2>').replace('</h1>','</h2>')}/><section class="wrap section"><div class="section-head"><div><div class="eyebrow">THE LEARNING PATH / ALL 28 PHASES</div><h2>From foundations<br/><em>to the flagship build.</em></h2></div><a class="text-link" href="/roadmap/">Full roadmap ↗</a></div><div class="space-roadmap">{roadmap.phases.map((p,i)=><a href={'/roadmap/#phase-'+i}><span>{String(i).padStart(2,'0')}</span><div><h3>{p.title}</h3><p>{p.subtitle}</p></div><small>{p.badge}</small></a>)}</div></section><script>import '../scripts/space.js';</script></Layout>