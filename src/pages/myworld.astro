---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
const tools=[['DeepSeek','/logos/Deepseek%20logo.jpg','AI models'],['Claude','/logos/claude.jpg','AI tools'],['GitHub Copilot','/logos/copilot.png','Developer tools'],['Antigravity','/logos/Antigravity.jpg','AI tools'],['Nmap','/logos/nmap.jpg','Network analysis'],['Burp Suite','/logos/burpsuite.jpg','Application security'],['Kali Linux','/logos/kali.jpg','Security tooling'],['Metasploit','/logos/metasploit.jpg','Security research'],['Gobuster','/logos/Gobuster.jpg','Reconnaissance'],['Fuzzing','/logos/fuzz.jpg','Security testing']];
---
<Layout title="My Technology World | Ganesh Naidu" description="A floating 3D world of AI, developer tools, compute and security technologies, with original portfolio artwork." path="/myworld/"><section class="wrap home-hero"><div><div class="eyebrow">EXPLORATION / MY TECHNOLOGY WORLD</div><h1>Many tools.<br/><em>One curious mind.</em></h1><p class="lead">AI, software engineering and security form a connected world. This is a visual collection of the technologies around my work and learning.</p><div class="actions"><a class="button dark" href="/work/">See what I build ↗</a><a class="button" href="/certifications/">Explore credentials</a></div><p class="small" style="margin-top:24px">The visual collection represents interests and tools, rather than proficiency or affiliation with each brand.</p></div><Scene/></section><section class="wrap section"><div class="section-head"><div><div class="eyebrow">THE TOOLBOX / ORIGINAL PORTFOLIO ARTWORK</div><h2>AI meets engineering.<br/><em>Security adds perspective.</em></h2></div></div><div class="tool-grid">{tools.map(([name,image,group])=><article class="card tool-card"><img src={image} alt={name+' logo'} width="80" height="80" loading="lazy"/><div class="meta">{group}</div><h3>{name}</h3></article>)}</div></section></Layout>